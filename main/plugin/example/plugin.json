{
  "name": "class-alert",
  "version": "1.0.0",
  "description": "综合示例插件，演示全部 7 个生命周期钩子及提醒机制",
  "author": "AstraSchedule",
  "main": "main.js",
  "renderer": "renderer.js",
  "permissions": ["fileSystem", "network"],
  "hooks": [
    "onInit",
    "onConfigLoad",
    "onRender",
    "onTick",
    "onTimeStateChange",
    "onScheduleReminder",
    "onDestroy"
  ],
  "reminders": [
    { "type": "class", "offset": -60 },
    { "type": "break", "offset": 30 }
  ]
}
