{
  "name": "example-plugin",
  "version": "1.0.0",
  "description": "示例插件，演示插件系统的基本用法",
  "author": "AstraSchedule",
  "main": "main.js",
  "renderer": "renderer.js",
  "permissions": ["fileSystem", "network"],
  "hooks": ["onInit", "onConfigLoad", "onRender"],
